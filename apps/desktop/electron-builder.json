{
  "appId": "ai.openpond.app",
  "productName": "openpond",
  "artifactName": "openpond-${version}-${os}-${arch}.${ext}",
  "asar": true,
  "directories": {
    "app": "apps/desktop/stage/app",
    "output": "release",
    "buildResources": "apps/desktop/build"
  },
  "icon": "apps/desktop/build/icon.png",
  "afterPack": "scripts/after-pack.cjs",
  "files": [
    "dist/**/*",
    "package.json",
    "!node_modules/**/*"
  ],
  "npmRebuild": false,
  "extraMetadata": {
    "main": "dist/main.js",
    "homepage": "https://openpond.ai",
    "license": "MIT"
  },
  "extraResources": [
    {
      "from": "apps/desktop/stage/runtime",
      "to": "."
    },
    {
      "from": "apps/desktop/build/icons",
      "to": "icons"
    },
    {
      "from": "LICENSE",
      "to": "LICENSE.openpond.txt"
    }
  ],
  "mac": {
    "icon": "apps/desktop/build/icon.icns",
    "category": "public.app-category.developer-tools",
    "forceCodeSigning": true,
    "hardenedRuntime": true,
    "entitlements": "apps/desktop/build/entitlements.mac.plist",
    "entitlementsInherit": "apps/desktop/build/entitlements.mac.inherit.plist",
    "notarize": true,
    "extendInfo": {
      "NSMicrophoneUsageDescription": "OpenPond uses the microphone for local voice dictation."
    },
    "target": ["zip"]
  },
  "win": {
    "icon": "apps/desktop/build/icon.ico",
    "target": ["nsis"]
  },
  "linux": {
    "executableName": "openpond-desktop",
    "icon": "apps/desktop/build/icons",
    "syncDesktopName": true,
    "target": ["AppImage", "deb"],
    "category": "Development",
    "desktop": {
      "entry": {
        "Name": "openpond",
        "Comment": "OpenPond desktop and local server app",
        "Icon": "openpond-desktop",
        "StartupWMClass": "openpond",
        "Categories": "Development;"
      }
    }
  },
  "deb": {
    "packageName": "openpond",
    "maintainer": "OpenPond <sam@openpond.ai>",
    "synopsis": "OpenPond desktop and local agent runtime",
    "packageCategory": "devel",
    "compression": "xz",
    "depends": [
      "libc6 (>= 2.35)",
      "libgtk-3-0t64 | libgtk-3-0",
      "libnotify4",
      "libnss3",
      "libxss1",
      "libxtst6",
      "xdg-utils",
      "libatspi2.0-0t64 | libatspi2.0-0",
      "libuuid1",
      "libsecret-1-0",
      "libasound2t64 | libasound2",
      "libgbm1"
    ],
    "recommends": []
  }
}
