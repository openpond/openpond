{
  "name": "@openpond/actions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "import": "./dist/local.js"
    }
  },
  "dependencies": {
    "esbuild": "0.28.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. --config vitest.config.ts --project actions",
    "check": "pnpm run typecheck && pnpm run test"
  }
}
