{
  "name": "@openpond/app-server",
  "version": "0.0.62",
  "openpondReleaseVersioned": true,
  "description": "Private canonical OpenPond agent-service composition",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
