{
  "name": "@openpond/agent-runtime",
  "version": "0.2.51",
  "openpondReleaseVersioned": true,
  "description": "Private host-neutral agent execution engine for OpenPond app-server",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./acp/claude-cli-client": {
      "types": "./dist/acp/claude-cli-client.d.ts",
      "import": "./dist/acp/claude-cli-client.js"
    },
    "./acp/client": {
      "types": "./dist/acp/client.d.ts",
      "import": "./dist/acp/client.js"
    },
    "./acp/types": {
      "types": "./dist/acp/types.d.ts",
      "import": "./dist/acp/types.js"
    },
    "./canonical": {
      "types": "./dist/canonical.d.ts",
      "import": "./dist/canonical.js"
    },
    "./compaction": {
      "types": "./dist/compaction.d.ts",
      "import": "./dist/compaction.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./host-storage-client": {
      "types": "./dist/host-storage-client.d.ts",
      "import": "./dist/host-storage-client.js"
    },
    "./jsonl": {
      "types": "./dist/jsonl.d.ts",
      "import": "./dist/jsonl.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./provider-loop": {
      "types": "./dist/provider-loop.d.ts",
      "import": "./dist/provider-loop.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "import": "./dist/service.js"
    },
    "./snapshots": {
      "types": "./dist/snapshots.d.ts",
      "import": "./dist/snapshots.js"
    },
    "./task-signals": {
      "types": "./dist/task-signals.d.ts",
      "import": "./dist/task-signals.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/run-typescript.mjs tsc -b",
    "typecheck": "node ../../scripts/run-typescript.mjs tsc --noEmit --project tsconfig.json",
    "test": "vitest run --root ../.. --config vitest.config.ts --project agent-runtime",
    "generate:protocol": "tsx scripts/generate-protocol-schema.ts",
    "check:protocol": "tsx scripts/generate-protocol-schema.ts --check",
    "check": "pnpm run typecheck && pnpm run test && pnpm run check:protocol && pnpm run build"
  },
  "dependencies": {
    "@openpond/harness": "workspace:*",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  }
}
