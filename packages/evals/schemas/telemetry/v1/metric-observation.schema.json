{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "openpond.metricObservation.v1"
    },
    "observationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "metricId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "value": {
      "type": "number"
    },
    "lineage": {
      "type": "object",
      "properties": {
        "modelProjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "modelVersionId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "harnessReleaseHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "tasksetReleaseHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "environmentReleaseHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkpointId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "step": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "rolloutGroupId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "attemptId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "scenarioId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "modelProjectId",
        "runId",
        "modelVersionId",
        "harnessReleaseHash",
        "tasksetReleaseHash",
        "environmentReleaseHash",
        "checkpointId",
        "step",
        "rolloutGroupId",
        "attemptId",
        "scenarioId"
      ],
      "additionalProperties": false
    },
    "dimensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 500
      }
    }
  },
  "required": [
    "schemaVersion",
    "observationId",
    "metricId",
    "eventId",
    "sequence",
    "observedAt",
    "value",
    "lineage",
    "dimensions"
  ],
  "additionalProperties": false
}
