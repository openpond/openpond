{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "openpond.runMetricSummary.v1"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "metricId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "aggregation": {
      "type": "string",
      "enum": [
        "last",
        "sum",
        "mean",
        "min",
        "max",
        "p50",
        "p95"
      ]
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "sampleCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "series": {
      "maxItems": 100000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "observedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "value": {
            "type": "number"
          },
          "sampleCount": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "step",
          "observedAt",
          "value",
          "sampleCount"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "metricId",
    "aggregation",
    "value",
    "sampleCount",
    "series"
  ],
  "additionalProperties": false
}
