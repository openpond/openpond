{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "openpond.rewardBinding.v1"
    },
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "description": {
      "type": "string",
      "maxLength": 10000
    },
    "recipeRef": {
      "$ref": "#/$defs/__schema1"
    },
    "sources": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema3"
      }
    },
    "aggregation": {
      "type": "string",
      "const": "weighted_mean"
    },
    "unscorable": {
      "type": "string",
      "const": "exclude_optional_require_all_required"
    },
    "contentHash": {
      "$ref": "#/$defs/__schema2"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "sources",
    "aggregation",
    "unscorable",
    "contentHash"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "contentHash": {
          "$ref": "#/$defs/__schema2"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "contentHash",
        "revision"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "graderId": {
          "$ref": "#/$defs/__schema0"
        },
        "reward": {
          "$ref": "#/$defs/__schema1"
        },
        "role": {
          "type": "string",
          "enum": [
            "training",
            "evaluation"
          ]
        },
        "normalization": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "identity"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "linear"
                },
                "minimum": {
                  "type": "number"
                },
                "maximum": {
                  "type": "number"
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "higher",
                    "lower"
                  ]
                }
              },
              "required": [
                "kind",
                "minimum",
                "maximum",
                "direction"
              ],
              "additionalProperties": false
            }
          ]
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "required": {
          "type": "boolean"
        },
        "hardGate": {
          "type": "boolean"
        },
        "privileged": {
          "type": "boolean"
        },
        "fixtureRefs": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema4"
          }
        }
      },
      "required": [
        "graderId",
        "reward",
        "role",
        "normalization",
        "weight",
        "required",
        "hardGate",
        "privileged",
        "fixtureRefs"
      ],
      "additionalProperties": false
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "contentHash": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "id",
        "contentHash"
      ],
      "additionalProperties": false
    }
  },
  "$id": "urn:openpond:learning:v1:binding",
  "$comment": "Generated from @openpond/evals. Cross-resource identity, authorization, idempotency, admission, grading and split constraints are enforced by the shared domain service in addition to this structural schema."
}
