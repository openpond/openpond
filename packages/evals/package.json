{
  "name": "@openpond/evals",
  "version": "0.7.1",
  "description": "Portable Tasksets, graders, evaluation runs, receipts, conformance fixtures, and Work evidence for OpenPond Harnesses",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "conformance",
    "schemas",
    "README.md",
    "CONTRACT.md",
    "RELEASING.md",
    "LEARNING.md",
    "LICENSE"
  ],
  "exports": {
    "./javascript-verifier/node": {
      "types": "./dist/types/javascript-verifier-node.d.ts",
      "import": "./dist/javascript-verifier-node.js"
    },
    "./javascript-verifier": {
      "types": "./dist/types/javascript-verifier.d.ts",
      "import": "./dist/javascript-verifier.js"
    },
    "./task-schema": {
      "types": "./dist/types/task-schema.d.ts",
      "import": "./dist/task-schema.js"
    },
    "./learning": {
      "types": "./dist/types/learning/index.d.ts",
      "import": "./dist/learning/index.js"
    },
    "./rewards": {
      "types": "./dist/types/rewards.d.ts",
      "import": "./dist/rewards.js"
    },
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./harness": {
      "types": "./dist/types/harness.d.ts",
      "import": "./dist/harness.js"
    },
    "./tasksets": {
      "types": "./dist/types/tasksets.d.ts",
      "import": "./dist/tasksets.js"
    },
    "./benchmarks": {
      "types": "./dist/types/benchmarks.d.ts",
      "import": "./dist/benchmarks.js"
    },
    "./graders": {
      "types": "./dist/types/graders.d.ts",
      "import": "./dist/graders.js"
    },
    "./runs": {
      "types": "./dist/types/runs.d.ts",
      "import": "./dist/runs.js"
    },
    "./rollouts": {
      "types": "./dist/types/rollouts.d.ts",
      "import": "./dist/rollouts.js"
    },
    "./telemetry": {
      "types": "./dist/types/telemetry/index.d.ts",
      "import": "./dist/telemetry/index.js"
    },
    "./preferences": {
      "types": "./dist/types/preferences.d.ts",
      "import": "./dist/preferences.js"
    },
    "./learned-preference": {
      "types": "./dist/types/learned-preference.d.ts",
      "import": "./dist/learned-preference.js"
    },
    "./review": {
      "types": "./dist/types/review-conformance.d.ts",
      "import": "./dist/review-conformance.js"
    },
    "./model-improvement-qualification": {
      "types": "./dist/types/model-improvement-qualification.d.ts",
      "import": "./dist/model-improvement-qualification.js"
    },
    "./conformance": {
      "types": "./dist/types/conformance.d.ts",
      "import": "./dist/conformance.js"
    },
    "./evidence": {
      "types": "./dist/types/evidence/index.d.ts",
      "import": "./dist/evidence/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openpond/openpond.git",
    "directory": "packages/evals"
  },
  "homepage": "https://github.com/openpond/openpond/tree/master/packages/evals#readme",
  "bugs": {
    "url": "https://github.com/openpond/openpond/issues"
  },
  "engines": {
    "node": ">=22.14.0 <25"
  },
  "scripts": {
    "build": "tsx scripts/generate-task-schema-validator.ts && tsx scripts/generate-telemetry-schemas.ts && tsx scripts/generate-learning-schemas.ts && tsx scripts/build.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run --root ../.. --config vitest.config.ts --project evals",
    "check:api": "tsx scripts/check-public-package.ts",
    "check:consumer": "tsx scripts/verify-packed-consumer.ts",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:api && pnpm run check:consumer && npm pack --dry-run",
    "publish:check": "pnpm run build && pnpm run check:api && pnpm run check:consumer && npm pack --dry-run"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "ajv": "^8.20.0",
    "quickjs-emscripten-core": "0.32.0",
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "@openpond/harness": "^0.2.0"
  },
  "devDependencies": {
    "@openpond/harness": "workspace:*",
    "@types/node": "24.13.3",
    "esbuild": "0.28.1",
    "tsx": "4.23.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  }
}
