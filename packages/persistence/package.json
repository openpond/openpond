{
  "name": "@openpond/persistence",
  "version": "0.2.56",
  "openpondReleaseVersioned": true,
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": {
      "types": "./dist/schemas/*.d.ts",
      "import": "./dist/schemas/*.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/run-typescript.mjs tsc -b"
  },
  "dependencies": {
    "toml-eslint-parser": "1.0.3",
    "zod": "^4.1.13",
    "@openpond/harness": "workspace:*"
  }
}
