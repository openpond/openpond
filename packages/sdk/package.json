{
  "name": "openpond-sdk",
  "version": "0.1.4",
  "description": "Server-side TypeScript SDK for OpenPond sandboxes and agentic work",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/packages/sdk/src/index.d.ts",
  "files": [
    "dist",
    "fixtures",
    "README.md",
    "TRAINING_PROTOCOL.md",
    "LICENSE",
    "examples",
    "LEARNING.md",
    "TASKSETS.md"
  ],
  "exports": {
    "./taskset-catalog": {
      "types": "./dist/types/packages/sdk/src/taskset-catalog.d.ts",
      "import": "./dist/taskset-catalog.js"
    },
    "./learning": {
      "types": "./dist/types/packages/sdk/src/learning.d.ts",
      "import": "./dist/learning.js"
    },
    ".": {
      "types": "./dist/types/packages/sdk/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./actions": {
      "types": "./dist/types/packages/sdk/src/actions.d.ts",
      "import": "./dist/actions.js"
    },
    "./actions/local": {
      "types": "./dist/types/packages/sdk/src/actions-local.d.ts",
      "import": "./dist/actions-local.js"
    },
    "./project-actions": {
      "types": "./dist/types/packages/sdk/src/project-actions.d.ts",
      "import": "./dist/project-actions.js"
    },
    "./profile-actions": {
      "types": "./dist/types/packages/sdk/src/profile-actions.d.ts",
      "import": "./dist/profile-actions.js"
    },
    "./workflows": {
      "types": "./dist/types/packages/sdk/src/workflows.d.ts",
      "import": "./dist/workflows.js"
    },
    "./refiner": {
      "types": "./dist/types/packages/sdk/src/refiner.d.ts",
      "import": "./dist/refiner.js"
    },
    "./model-projects": {
      "types": "./dist/types/packages/sdk/src/model-projects.d.ts",
      "import": "./dist/model-projects.js"
    },
    "./training": {
      "types": "./dist/types/packages/sdk/src/training.d.ts",
      "import": "./dist/training.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openpond/openpond.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/openpond/openpond/tree/master/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/openpond/openpond/issues"
  },
  "engines": {
    "node": ">=22.14.0 <25"
  },
  "openpondBundledSourceDependencies": [
    "@openpond/actions",
    "@openpond/cloud",
    "@openpond/harness"
  ],
  "scripts": {
    "prebuild": "pnpm --dir ../cloud run build && pnpm --dir ../harness run build && pnpm --dir ../evals run build",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run --root ../.. --config vitest.config.ts --project sdk",
    "check": "pnpm run build && pnpm run typecheck && pnpm run test && tsx scripts/check-protocol-fixtures.ts && tsx scripts/check-published-consumer.ts --local-evals && npm pack --dry-run",
    "publish:check": "pnpm run build && tsx scripts/check-protocol-fixtures.ts && tsx scripts/check-published-consumer.ts && npm pack --dry-run"
  },
  "devDependencies": {
    "@openpond/actions": "workspace:*",
    "@openpond/cloud": "workspace:*",
    "@types/node": "24.13.3",
    "esbuild": "0.28.1",
    "tsx": "4.23.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@openpond/evals": "^0.7.1",
    "@openpond/harness": "^0.2.5",
    "esbuild": "0.28.1",
    "zod": "^4.1.13"
  }
}
