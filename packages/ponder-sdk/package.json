    "type": "git",
    "url": "git+https://github.com/openpond/openpond.git",
    "directory": "packages/ponder-sdk"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs && node scripts/check-published-consumer.mjs",
